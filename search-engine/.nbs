   ],
   "source": [
    "lucene.initVM(vmargs=[\"-Djava.awt.headless=true\"])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "query = \"respiratory\"\n",
    "# modalities = ['oth']\n",
    "results = reader.search(\n",
    "    terms=query,\n",
    "    start_date=None,\n",
    "    end_date=None,\n",
    "    modalities=None,\n",
    "    only_with_images=True,\n",
    "    ft=True,\n",
    "    highlight=True,\n",
    ")\n",
    "# TODO: Fix when highlight=False so variable has some value set"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 62,
   "metadata": {},
   "outputs": [],
   "source": [
    "from org.apache.lucene.analysis.standard import StandardAnalyzer\n",
    "from org.apache.lucene.search.highlight import (\n",
    "    SimpleHTMLFormatter,\n",
    "    QueryScorer,\n",
    "    Highlighter,\n",
    "    SimpleSpanFragmenter,\n",
    "    GradientFormatter,\n",
    ")\n",
    "from java.io import StringReader\n",
    "from IPython.display import Markdown as md"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "metadata": {},
   "outputs": [],
   "source": [
    "highlight_formatter = SimpleHTMLFormatter()\n",
    "# highlight_formatter = GradientFormatter(10.0, '#000000', '#000000', '#FFFFFF', '#FF0000')\n",
    "query_scorer = QueryScorer(reader.get_last_query())\n",
    "highlighter = Highlighter(highlight_formatter, query_scorer)\n",
    "analyzer = StandardAnalyzer()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "metadata": {},
   "outputs": [
    {
     "data": {
