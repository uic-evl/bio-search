       " SearchResult(id=None, title='Clinical features of culture-proven Mycoplasma pneumoniae infections at King Abdulaziz University Hospital, Jeddah, Saudi Arabia', abstract='OBJECTIVE: This retrospective chart review describes the epidemiology and clinical features of 40 patients with culture-proven Mycoplasma pneumoniae infections at King Abdulaziz University Hospital, Jeddah, Saudi Arabia. METHODS: Patients with positive M. pneumoniae cultures from <B>respiratory</B> specimens from January 1997 through December 1998 were identified through the Microbiology records. Charts... comorbidities. Twenty-four isolates (60%) were associated with pneumonia, 14 (35%) with upper <B>respiratory</B> tract infections, and 2 (5%) with bronchiolitis. Cough (82.5%), fever (75%), and malaise (58.8%) were', publish_date='2025-10-10', modalities=['oth'], num_figures=2, url='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC35282/', full_text='', journal='BMC Infect Dis', authors='Madani, Tariq A; Al-Ghamdi, Aisha A', captions=[], modalities_count={}),\n",
       " SearchResult(id=None, title='Surfactant protein-D and pulmonary host defense', abstract=' observation that SP-D-deficient transgenic mice show abnormal accumulations of surfactant lipids, and respond abnormally to challenge with <B>respiratory</B> viruses and bacterial lipopolysaccharides. The phenotype', publish_date='2025-10-10', modalities=['oth'], num_figures=2, url='https://www.ncbi.nlm.nih.gov/pmc/articles/PMC59549/', full_text='', journal='Respir Res', authors='Crouch, Erika C', captions=[], modalities_count={})]"
